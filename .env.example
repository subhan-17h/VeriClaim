# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Model providers -------------------------------------------------------
# Two providers are configured so the gateway's fallback ladder can cross providers
# rather than merely retrying the same one. See config.yaml for the routing table.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- LangSmith tracing -----------------------------------------------------
# Tracing is opt-in. Without a key, @traced is a transparent no-op and everything
# still runs, so tests and offline development need no credentials.
#
# Off by default, and the default is the honest one: the free plan allows 5,000 traces
# a month and the whole evaluation suite has to fit inside that. Turn it on deliberately
# for an eval run or a demo, the way VC_ALLOW_PAID_FALLBACK is turned on for spend.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vericlaim

# --- PostgreSQL ------------------------------------------------------------
# Port 5435 avoids the default 5432 and the Supabase stack on 54321-54324.
# The readonly role is a genuine Postgres role with SELECT only - it is the last
# line of SQL defence beneath the AST validator, not a convention.
POSTGRES_PASSWORD=
READONLY_PASSWORD=

# --- Local embeddings ------------------------------------------------------
# Requires `ollama pull nomic-embed-text`.
OLLAMA_HOST=http://127.0.0.1:11434

# --- Cost control ----------------------------------------------------------
# Paid providers are refused by default; the free Gemini tier serves every task.
# Set to true only for a deliberate demo or a paid evaluation run.
VC_ALLOW_PAID_FALLBACK=false
# Ceilings sized for a $1.00 prepaid OpenAI credit. The lifetime figure persists to
# .vericlaim_cache/spend.json, so restarting does not reset it.
VC_MAX_COST_USD_LIFETIME=0.50
VC_MAX_COST_USD_TOTAL=0.25
VC_MAX_COST_USD_PER_REQUEST=0.02

# --- Optional overrides ----------------------------------------------------
# Any Settings field can be overridden with the VC_ prefix, e.g.:
# VC_CHUNK_SIZE=512
# VC_OCR_CONFIDENCE_FLOOR=0.7
# VC_RERANK_ENABLED=false
